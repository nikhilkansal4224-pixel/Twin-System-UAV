# =====================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =====================================================================
POSTGRES_USER=uav_user
POSTGRES_PASSWORD=uav_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uav_telemetry

# Unified Connection URL (for SQLAlchemy / Psycopg / Retraining Workers)
DATABASE_URL=postgresql://uav_user:uav_password@localhost:5432/uav_telemetry

# =====================================================================
# KAFKA MESSAGE BUS CONFIGURATION
# =====================================================================
KAFKA_BROKER=127.0.0.1:9092
KAFKA_TOPIC=uav-engine-telemetry
KAFKA_CONSUMER_GROUP=digital-twin-orchestrator

# =====================================================================
# PHYSICAL ENGINE & MODEL SETTINGS
# =====================================================================
NOMINAL_MAX_LIFE_HOURS=1200.0
LSTM_SEQUENCE_LENGTH=10
PINN_MODEL_PATH=pinn_model_latest.pth
LSTM_MODEL_PATH=lstm_rul_latest.pth

# =====================================================================
# GRAFANA CONFIGURATION
# =====================================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=1s